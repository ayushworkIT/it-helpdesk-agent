# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini

# Where the Chroma vector database is stored.
# Keep it OUTSIDE cloud-synced folders (OneDrive, Dropbox) to avoid file-lock errors.
CHROMA_DIR=C:/Users/YOUR-USERNAME/rag-data/it-helpdesk-chroma
# MCP server (Follow-up Task 1: SSE). Start it first: python helpdesk_server.py
MCP_URL=http://127.0.0.1:8003/sse

